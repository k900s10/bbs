    <!-- Myths vs Facts Section -->
    <string name="myths_facts_title">Klarifikasi Penting: Mitos vs Fakta</string>
    <string name="myths_facts_subtitle">Kami mendengar pertanyaan relawan: &lt;i&gt;&quot;Kok bersih-bersih bayar?&quot;&lt;/i&gt; Mari kita luruskan kesalahpahaman ini agar setiap aksi kita dilandasi rasa percaya.</string>

    <string name="myths_heading">Mitos / Kesalahan Persepsi</string>
    <string name="myth_item_1">Rp20.000 adalah tiket masuk atau biaya wajib pendaftaran aksi bersih-bersih.</string>
    <string name="myth_item_2">Relawan yang tidak berdonasi tidak diperbolehkan bergabung dalam kegiatan.</string>
    <string name="myth_item_3">Uang donasi digunakan untuk komersial atau operasional internal panitia.</string>

    <string name="facts_heading">Fakta Sebenarnya</string>
    <string name="fact_item_1">&lt;strong&gt;Aksi Bersih-Bersih 100% GRATIS.&lt;/strong&gt; Siapa saja boleh ikut tanpa syarat membayar.</string>
    <string name="fact_item_2">Rp20.000 via QRIS adalah &lt;strong&gt;donasi sukarela terpisah&lt;/strong&gt; untuk disalurkan ke program sosial lain.</string>
    <string name="fact_item_3">100% donasi dialokasikan untuk &lt;strong&gt;Program Rantang Kasih&lt;/strong&gt; (Pangan lokal Nusantara bagi masyarakat yang membutuhkan).</string>

